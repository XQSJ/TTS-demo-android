<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Offline Multilingual TTS"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline4"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="ONNX · Java · ARM64 / ARMv7"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#1A6200EE"
            android:padding="12dp"
            android:text="正在加载模型… / Loading model…"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/downloadLanguageButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="安装语言包" />

            <Button
                android:id="@+id/downloadVoiceButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="安装音色包" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="语言与音色 / Voice" android:textStyle="bold" />
        <Spinner android:id="@+id/voiceSpinner" android:layout_width="match_parent" android:layout_height="48dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="示例 / Sample" android:textStyle="bold" />
        <Spinner android:id="@+id/sampleSpinner" android:layout_width="match_parent" android:layout_height="48dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="输入文本 / Text" android:textStyle="bold" />
        <EditText
            android:id="@+id/textInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="4"
            android:padding="12dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/speedSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:stepSize="0.05"
            android:value="1.0"
            android:valueFrom="0.7"
            android:valueTo="1.4" />
        <TextView android:id="@+id/speedText" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="语速 / Speed: 1.00" />

        <!-- 进阶调优：噪声系数（合成多样性）与时长噪声（节奏随机度）。/ Advanced tuning: synthesis noise (variety) and duration noise (rhythm). -->
        <com.google.android.material.slider.Slider
            android:id="@+id/noiseSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:stepSize="0.05"
            android:value="0.667"
            android:valueFrom="0.0"
            android:valueTo="1.5" />
        <TextView android:id="@+id/noiseText" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="噪声 / Noise: 0.67" />
        <com.google.android.material.slider.Slider
            android:id="@+id/durationNoiseSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:stepSize="0.05"
            android:value="0.35"
            android:valueFrom="0.0"
            android:valueTo="1.0" />
        <TextView android:id="@+id/durationNoiseText" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="节奏噪声 / Duration noise: 0.35" />

        <Button android:id="@+id/synthesizeButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:enabled="false" android:text="合成并播放 / Synthesize" />
        <Button android:id="@+id/stopButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="停止 / Stop" />
        <Button android:id="@+id/saveWavButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:enabled="false" android:text="保存 WAV / Save" />

        <TextView android:id="@+id/metricsText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />
    </LinearLayout>
</ScrollView>
